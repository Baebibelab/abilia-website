---
// Appel à télécharger l'app. Tant que `APP_STORE_URL` (src/config.ts) est vide, c'est une
// pastille « Bientôt sur l'App Store », pas un lien, qui n'a pas l'air d'un bouton : fond de
// verre et filet, sans ombre ni curseur de lien.
// Le jour du lancement : Apple impose son badge officiel « Télécharger dans l'App Store »
// (https://developer.apple.com/app-store/marketing/guidelines/), tel quel et dans la langue de
// la page. Ne pas dessiner un faux badge ni utiliser le logo Apple ici.
//
// `pulse` : le point de « Bientôt » bat doucement (le hero seulement : dans l'en-tête fixe, la
// boucle tournerait toute la visite). La pastille porte alors `data-loop`.
import { APP_STORE_URL } from '../config';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  size?: 'small' | 'large';
  pulse?: boolean;
  class?: string;
}

const { lang, size = 'large', pulse = false, class: className } = Astro.props;
const t = useTranslations(lang);
---

{
  APP_STORE_URL ? (
    <a class:list={['button', 'button--primary', 'app-store', `app-store--${size}`, className]} href={APP_STORE_URL}>
      {t('cta.download')}
    </a>
  ) : (
    <span
      class:list={['button', 'app-store', 'app-store--soon', `app-store--${size}`, className]}
      data-loop={pulse ? '' : undefined}
    >
      <span class:list={['app-store__dot', { 'app-store__dot--pulse': pulse }]} aria-hidden="true"></span>
      {t('cta.appStore')}
    </span>
  )
}

<style>
  .app-store--small {
    min-height: 40px;
    padding: 0 1.1em;
    font-size: 0.9rem;
  }

  /* « Bientôt » n'est pas un bouton : pas l'aplat ni l'ombre du bouton principal, un fond de
     verre bordé d'un filet, et ni curseur de lien ni soulèvement au survol. */
  .app-store--soon {
    background: var(--glass-bg);
    border: 1px solid var(--border);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: none;
    color: var(--text);
    cursor: default;
  }

  .app-store--soon:hover {
    transform: none;
  }

  @media (prefers-reduced-transparency: reduce) {
    .app-store--soon {
      background: var(--bg-elevated);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .app-store__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--coral);
  }

  /* L'onde qui part du point : un disque qui grandit en s'effaçant (`transform` et `opacity`
     seulement, sans repeindre la pastille). */
  @media (prefers-reduced-motion: no-preference) {
    .app-store__dot--pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--coral);
      opacity: 0;
      animation: pulse 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes pulse {
    0% {
      opacity: 0.6;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(3);
    }
  }
</style>
