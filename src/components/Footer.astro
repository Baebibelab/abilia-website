---
import AppIcon from './AppIcon.astro';
import { FIRST_YEAR, JELLYFIN_URL, PUBLISHER } from '../config';
import { type Lang, pathFor, supportSections, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Le « © » porte le nom de l'éditeur (mentions légales de la page Assistance), de la première année
// de publication à celle du build : « 2026 », puis « 2026–2027 »…
const year = new Date().getFullYear();
const years = year > FIRST_YEAR ? `${FIRST_YEAR}–${year}` : `${FIRST_YEAR}`;
const support = pathFor('support', lang);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__start">
      <div class="site-footer__brand">
        <AppIcon size={28} />
        <span>Andia</span>
        <span class="site-footer__tagline">{t('footer.tagline')}</span>
      </div>
      <nav aria-label={t('footer.nav')}>
        <a class="site-footer__link" href={support}>{t('footer.support')}</a>
        <a class="site-footer__link" href={pathFor('privacy', lang)}>{t('footer.privacy')}</a>
        <a class="site-footer__link" href={`${support}#${supportSections.legal[lang]}`}>{t('footer.legal')}</a>
      </nav>
    </div>
    <div class="site-footer__legal">
      <p>
        © {years} {PUBLISHER.name} · <a href={JELLYFIN_URL} rel="noopener">Jellyfin</a> — {t('footer.jellyfin')}
      </p>
      <p>{t('footer.apple')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(80px, 12vw, 160px);
    padding-block: 40px calc(40px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
  }

  .site-footer__tagline {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .site-footer__start {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  .site-footer__start nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .site-footer__legal {
    display: grid;
    gap: 4px;
    max-width: 560px;
  }

  .site-footer__legal a {
    color: var(--text);
  }
</style>
