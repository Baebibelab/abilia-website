---
// Haut de l'accueil : titre, appel App Store, et l'iPhone qui joue un morceau (capture En
// lecture, son spectre qui danse), entouré de halos, d'un grand spectre lumineux, de l'icône et
// de pastilles en verre.
//
// Mouvement, en trois temps :
// - à l'arrivée, les mots du titre se suivent, l'iPhone se redresse en 3D, le spectre s'ouvre,
//   l'icône et les pastilles se posent (animations CSS, seulement sous `html.js`) ;
// - au repos, l'iPhone flotte et suit le pointeur (souris ou trackpad seulement, hero.ts), les
//   halos tournent, les spectres jouent ;
// - en quittant le haut de page, `--exit` (0 → 1, tiré du `--progress` de `data-scroll`) remonte
//   et efface le texte, aplatit l'iPhone et écarte les pastilles.
// Avec « Réduire les animations », tout est en place d'emblée et immobile ; sans JavaScript,
// tout est visible et les spectres (CSS) jouent quand même.
import AppIcon from '../AppIcon.astro';
import AppStoreButton from '../AppStoreButton.astro';
import PhoneFrame from '../PhoneFrame.astro';
import HeroSpectrum from './hero/HeroSpectrum.astro';
import PhoneSpectrum from './hero/PhoneSpectrum.astro';
import enLecture from '../../assets/screenshots/en-lecture.jpg';
import { type Lang, useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const firstLine = t('hero.title.1').split(' ');

const highlights = [t('hero.highlight.lossless'), t('hero.highlight.offline'), t('hero.highlight.private')];

// Pastilles autour de l'iPhone. `--dx` / `--dy` : direction dans laquelle elles s'écartent
// quand le hero quitte l'écran ; `--float` : durée de leur flottement.
const chips = [
  {
    key: 'format',
    label: t('hero.chip.format.label'),
    value: t('hero.chip.format.value'),
    style: '--dx: -1; --dy: -0.6; --float: 6.5s; --chip-delay: 1.05s',
  },
  {
    key: 'offline',
    label: t('hero.chip.offline.label'),
    value: t('hero.chip.offline.value'),
    style: '--dx: 1; --dy: 0.1; --float: 7.5s; --chip-delay: 1.2s',
  },
  {
    key: 'everywhere',
    label: t('hero.chip.everywhere.label'),
    value: t('hero.chip.everywhere.value'),
    style: '--dx: -0.8; --dy: 0.7; --float: 8.5s; --chip-delay: 1.35s',
  },
] as const;
---

<section class="hero" data-scroll>
  <div class="hero__backdrop" aria-hidden="true">
    <div class="hero__glow">
      <span class="hero__blob hero__blob--teal"></span>
      <span class="hero__blob hero__blob--indigo"></span>
      <span class="hero__blob hero__blob--coral"></span>
    </div>
    <div class="hero__spectrum">
      <HeroSpectrum />
    </div>
  </div>

  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow" data-reveal="fade">
        <AppIcon size={22} />
        <span>{t('hero.eyebrow')}</span>
      </p>

      <h1 class="hero__title">
        <span class="hero__line" data-reveal-stagger="80">
          {
            firstLine.map((word, index) => (
              <>
                <span class="hero__word" data-reveal="blur" data-reveal-delay="100">
                  {word}
                </span>
                {index < firstLine.length - 1 && ' '}
              </>
            ))
          }
        </span>
        <span class="hero__line hero__line--accent gradient-text" data-reveal="blur" data-reveal-delay="420">
          {t('hero.title.2')}
        </span>
      </h1>

      <p class="hero__lead" data-reveal data-reveal-delay="600">{t('hero.lead')}</p>

      <div class="hero__actions" data-reveal data-reveal-delay="720">
        <AppStoreButton lang={lang} />
        <a class="button button--ghost" href="#features">{t('cta.discover')}</a>
      </div>

      <ul class="hero__highlights" data-reveal="fade" data-reveal-delay="880">
        {
          highlights.map((item) => (
            <li>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__stage">
        <div class="hero__float">
          <div class="hero__device">
            <div class="hero__phone">
              <PhoneFrame src={enLecture} alt={t('screenshot.nowPlaying')} width={320} loading="eager" />
              <PhoneSpectrum />
              <span class="hero__glare" aria-hidden="true"></span>
            </div>
          </div>
          <span class="hero__shadow" aria-hidden="true"></span>
        </div>

        <div class="hero__icon" aria-hidden="true">
          <div class="hero__icon-inner">
            <AppIcon size={96} class="hero__icon-svg" />
          </div>
        </div>

        <ul class="hero__chips">
          {
            chips.map((chip) => (
              <li class:list={['hero__chip', `hero__chip--${chip.key}`]} style={chip.style}>
                <div class="hero__chip-card glass">
                  <span class="hero__chip-icon" aria-hidden="true">
                    {chip.key === 'format' && (
                      <svg viewBox="0 0 24 24" width="18" height="18">
                        <path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                      </svg>
                    )}
                    {chip.key === 'offline' && (
                      <svg viewBox="0 0 24 24" width="18" height="18">
                        <path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 19.5h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {chip.key === 'everywhere' && (
                      <svg viewBox="0 0 24 24" width="18" height="18">
                        <rect x="7" y="5" width="10" height="14" rx="3.5" fill="none" stroke="currentColor" stroke-width="2.2" />
                        <path d="M9.5 5l.6-2.5h3.8L14.5 5M9.5 19l.6 2.5h3.8l.6-2.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                  <span class="hero__chip-text">
                    <span class="hero__chip-label">{chip.label}</span>
                    <span class="hero__chip-value">{chip.value}</span>
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <span class="hero__cue" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22">
      <path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</section>

<script>
  import './hero/hero';
</script>

<style>
  .hero {
    /* 0 tant que le hero occupe l'écran, 1 quand il l'a quitté (`--progress` vaut 0,5 en haut
       de page pour un hero d'un écran de haut). Sans JavaScript : 0. */
    --exit: clamp(0, calc((var(--progress, 0.5) - var(--exit-start)) * var(--exit-rate)), 1);
    --exit-start: 0.5;
    --exit-rate: 2.2;
    /* Inclinaison de l'iPhone au repos. */
    --rest-y: -16deg;
    /* Inclinaison suivie au pointeur, de -1 à 1 (hero.ts). */
    --tx: 0;
    --ty: 0;
    --hero-phone: clamp(230px, min(24vw, calc((100svh - 190px) * 0.455)), 310px);

    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-height) + 32px) 88px;
    overflow-x: clip;
  }

  /* ---------- Fond local : halos qui tournent et grand spectre ---------- */

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__glow {
    position: absolute;
    top: 50%;
    left: 72%;
    width: min(980px, 120vw);
    aspect-ratio: 1;
    translate: -50% -50%;
  }

  .hero__blob {
    position: absolute;
    width: 58%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .hero__blob--teal {
    top: 4%;
    left: 8%;
    background: radial-gradient(closest-side, var(--halo-teal), transparent);
  }

  .hero__blob--indigo {
    top: 30%;
    right: 2%;
    background: radial-gradient(closest-side, var(--halo-indigo), transparent);
  }

  .hero__blob--coral {
    bottom: 2%;
    left: 22%;
    width: 48%;
    background: radial-gradient(closest-side, var(--halo-coral), transparent);
  }

  .hero__spectrum {
    position: absolute;
    inset-inline: 0;
    top: 58%;
    translate: 0 -50%;
    opacity: calc(1 - var(--exit) * 0.6);
  }

  .hero__spectrum :global(.hero-spectrum) {
    position: relative;
    /* Le spectre reste du côté de l'iPhone : jamais derrière le titre. */
    -webkit-mask-image: linear-gradient(90deg, transparent 42%, #000 64%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent 42%, #000 64%, #000 90%, transparent);
  }

  /* ---------- Texte ---------- */

  .hero__inner {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: clamp(40px, 5vw, 80px);
  }

  .hero__text {
    display: grid;
    justify-items: start;
    gap: 24px;
    opacity: calc(1 - var(--exit) * 1.25);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--radius-pill);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    color: var(--coral-strong);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__eyebrow :global(.app-icon) {
    border-radius: 6px;
    filter: none;
  }

  .hero__title {
    font-size: clamp(2.6rem, 5.7vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
  }

  /* Un peu d'air sous la ligne dégradée : les jambages (q, p) ne sont pas rognés par le clip. */
  .hero__line--accent {
    padding-bottom: 0.08em;
    background-size: 200% 100%;
  }

  .hero__lead {
    max-width: 33em;
    color: var(--text-secondary);
    font-size: clamp(1.08rem, 1.5vw, 1.28rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hero__highlights svg {
    color: var(--teal);
  }

  /* ---------- iPhone ---------- */

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__stage {
    position: relative;
    width: var(--hero-phone);
    container-type: inline-size;
  }

  .hero__float {
    position: relative;
    perspective: 1600px;
  }

  .hero__device {
    transform-style: preserve-3d;
  }

  .hero__phone {
    position: relative;
    container-type: inline-size;
    --phone-width: 100cqw;
  }

  /* Reflet qui glisse sur la vitre quand l'iPhone tourne. */
  .hero__glare {
    position: absolute;
    inset: 3.5cqw;
    border-radius: 13.5cqw;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__glare::before {
    content: '';
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(
      105deg,
      transparent 38%,
      rgb(255 255 255 / 0.16) 47%,
      rgb(255 255 255 / 0.05) 53%,
      transparent 60%
    );
    translate: calc(-28% + var(--tx) * 10% + var(--exit) * 40%) 0;
  }

  .hero__shadow {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -7%;
    height: 9%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(10 20 40 / 0.35), transparent);
    z-index: -1;
  }

  /* ---------- Icône ---------- */

  .hero__icon {
    position: absolute;
    top: 7%;
    right: -19%;
    width: 30cqw;
    z-index: 2;
  }

  .hero__icon-inner {
    rotate: 10deg;
  }

  .hero__icon :global(.hero__icon-svg) {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 30px rgb(255 107 74 / 0.4)) drop-shadow(0 4px 8px rgb(0 0 0 / 0.18));
  }

  /* ---------- Pastilles ---------- */

  .hero__chips {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__chip {
    position: absolute;
    z-index: 3;
    opacity: calc(1 - var(--exit) * 1.4);
  }

  .hero__chip--format {
    top: 31%;
    left: -40%;
  }

  .hero__chip--offline {
    top: 61%;
    right: -36%;
  }

  .hero__chip--everywhere {
    bottom: 6%;
    left: -32%;
  }

  .hero__chip-card {
    display: flex;
    text-align: start;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 10px;
    border-radius: 18px;
    white-space: nowrap;
  }

  .hero__chip-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 11px;
    color: #fff;
  }

  .hero__chip--format .hero__chip-icon {
    background: linear-gradient(135deg, var(--coral), var(--purple));
  }

  .hero__chip--offline .hero__chip-icon {
    background: linear-gradient(135deg, var(--teal), var(--indigo));
  }

  .hero__chip--everywhere .hero__chip-icon {
    background: linear-gradient(135deg, var(--indigo), var(--purple));
  }

  .hero__chip-text {
    display: grid;
    line-height: 1.25;
  }

  .hero__chip-label {
    color: var(--text-secondary);
    font-size: 0.74rem;
    font-weight: 600;
  }

  .hero__chip-value {
    font-size: 0.9rem;
    font-weight: 700;
  }

  /* ---------- Indice de défilement ---------- */

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    border-radius: 50%;
    color: var(--text-secondary);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: opacity 0.5s var(--ease-out);
  }

  :global(html.is-scrolled) .hero__cue {
    opacity: 0;
  }

  /* ---------- Mouvement ---------- */

  @media (prefers-reduced-motion: no-preference) {
    /* Le texte remonte en quittant l'écran ; l'iPhone se redresse, l'icône file plus vite. */
    .hero__text {
      translate: 0 calc(var(--exit) * -70px);
    }

    .hero__stage {
      translate: 0 calc(var(--exit) * -50px);
      scale: calc(1 + var(--exit) * 0.06);
    }

    .hero__device {
      transform: rotateY(calc((1 - var(--exit)) * var(--rest-y) + var(--tx) * 9deg))
        rotateX(calc((1 - var(--exit)) * 5deg - var(--ty) * 7deg))
        rotateZ(calc((1 - var(--exit)) * 1.5deg));
    }

    .hero__icon {
      transform: translate3d(calc(var(--tx) * 14px), calc(var(--ty) * 10px + var(--exit) * -150px), 0)
        rotate(calc(var(--exit) * 24deg));
    }

    .hero__chip {
      transform: translate3d(
        calc(var(--dx) * var(--exit) * 140px + var(--tx) * 18px * var(--dx)),
        calc(var(--dy) * var(--exit) * 120px + var(--ty) * 10px),
        0
      );
    }

    .hero__glow {
      rotate: calc(var(--exit) * 50deg);
    }

    .hero__spectrum {
      scale: 1 calc(1 + var(--exit) * 0.5);
    }

    /* Boucles : halos qui tournent et respirent, iPhone qui flotte, pastilles qui dérivent,
       dégradé du titre qui glisse, flèche qui invite à descendre. */
    .hero__blob--teal {
      animation: hero-orbit 26s linear infinite;
    }

    .hero__blob--indigo {
      animation: hero-orbit 32s linear infinite reverse;
    }

    .hero__blob--coral {
      animation: hero-breathe 9s ease-in-out infinite alternate;
    }

    .hero__float {
      animation: hero-float 7s ease-in-out infinite alternate;
    }

    .hero__icon-inner {
      animation: hero-bob 5.5s ease-in-out infinite alternate;
    }

    .hero__chip-card {
      animation: hero-drift var(--float) ease-in-out infinite alternate;
    }

    .hero__line--accent {
      animation: hero-shine 9s ease-in-out infinite alternate;
    }

    .hero__cue svg {
      animation: hero-cue 2.2s var(--ease-out) infinite;
    }

    /* Arrivée (seulement avec JavaScript, pour ne rien cacher sans lui). */
    :global(html.js) .hero__stage {
      animation: hero-phone-in 1.5s var(--ease-out) 0.2s backwards;
    }

    :global(html.js) .hero__icon-inner {
      animation:
        hero-icon-in 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.85s backwards,
        hero-bob 5.5s ease-in-out 1.95s infinite alternate;
    }

    :global(html.js) .hero__chip-card {
      animation:
        hero-chip-in 0.9s cubic-bezier(0.34, 1.4, 0.64, 1) var(--chip-delay) backwards,
        hero-drift var(--float) ease-in-out calc(var(--chip-delay) + 0.9s) infinite alternate;
    }

    :global(html.js) .hero__glow {
      animation: hero-glow-in 2.2s var(--ease-out) backwards;
    }

    :global(html.js) .hero__cue {
      animation: hero-fade-in 1s var(--ease-out) 1.8s backwards;
    }

    /* Hors de l'écran, les boucles s'arrêtent (hero.ts). */
    .hero.is-idle,
    .hero.is-idle * {
      animation-play-state: paused !important;
    }
  }

  @keyframes hero-orbit {
    from {
      transform: rotate(0deg) translateX(7%) rotate(0deg);
    }
    to {
      transform: rotate(360deg) translateX(7%) rotate(-360deg);
    }
  }

  @keyframes hero-breathe {
    to {
      transform: scale(1.25) translate3d(8%, -6%, 0);
    }
  }

  @keyframes hero-float {
    from {
      translate: 0 -8px;
    }
    to {
      translate: 0 10px;
    }
  }

  @keyframes hero-bob {
    from {
      translate: 0 -6px;
      rotate: 8deg;
    }
    to {
      translate: 0 8px;
      rotate: 13deg;
    }
  }

  @keyframes hero-drift {
    from {
      translate: 0 -5px;
    }
    to {
      translate: 0 6px;
    }
  }

  @keyframes hero-shine {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 100% 50%;
    }
  }

  @keyframes hero-cue {
    0%,
    100% {
      transform: translateY(-2px);
      opacity: 0.6;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  @keyframes hero-phone-in {
    from {
      opacity: 0;
      transform: perspective(1200px) translateY(90px) rotateX(28deg) scale(0.9);
    }
  }

  @keyframes hero-icon-in {
    from {
      opacity: 0;
      transform: translateY(-30px) scale(0.4) rotate(-40deg);
    }
  }

  @keyframes hero-chip-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.85);
    }
  }

  @keyframes hero-glow-in {
    from {
      opacity: 0;
      scale: 0.7;
    }
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero__eyebrow,
    .hero__cue {
      background: var(--bg-elevated);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* ---------- Téléphone et tablette en portrait : une seule colonne ---------- */

  @media (max-width: 860px) {
    .hero {
      --hero-phone: min(280px, 60vw);
      --rest-y: -8deg;
      /* Le hero dépasse l'écran : l'iPhone ne s'efface qu'une fois en haut de l'écran, et le
         texte, déjà passé, ne s'efface pas. */
      --exit-start: 0.62;
      --exit-rate: 2.8;
      padding-bottom: 96px;
    }

    .hero__text {
      opacity: 1;
    }

    .hero__spectrum :global(.hero-spectrum) {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }

    .hero__text {
      justify-items: center;
    }

    .hero__actions,
    .hero__highlights {
      justify-content: center;
    }

    .hero__glow {
      top: auto;
      bottom: 0;
      left: 50%;
      translate: -50% 10%;
    }

    .hero__spectrum {
      top: auto;
      bottom: 24%;
      translate: 0;
      --spectrum-height: 180px;
    }

    .hero__icon {
      right: -14%;
      width: 26cqw;
    }

    .hero__chip-card {
      gap: 8px;
      padding: 7px 12px 7px 7px;
      border-radius: 14px;
    }

    .hero__chip-icon {
      width: 28px;
      height: 28px;
      border-radius: 9px;
    }

    .hero__chip-icon svg {
      width: 15px;
      height: 15px;
    }

    .hero__chip-label {
      font-size: 0.66rem;
    }

    .hero__chip-value {
      font-size: 0.78rem;
    }

    .hero__chip--format {
      left: -16%;
    }

    /* Plus bas qu'à l'écran large : ici, la pastille couvrirait le titre du morceau. */
