---
// Section provisoire (étape 1) : ancre `#offline` du menu, titre et une capture. Les vraies
// sections animées la remplacent.
import Section from '../../Section.astro';
import PhoneFrame from '../../PhoneFrame.astro';
import shot from '../../../assets/screenshots/telechargements.jpg';
import { type Lang, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="offline" eyebrow={t('offline.eyebrow')} title={t('offline.title')} lead={t('offline.lead')} align="center">
  <div class="visual" data-scroll>
    <div data-reveal="up">
      <PhoneFrame src={shot} alt={t('screenshot.downloads')} width={280} />
    </div>
  </div>
</Section>

<style>
  .visual {
    display: flex;
    justify-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .visual :global(.phone) {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * -80px));
    }
  }
</style>
