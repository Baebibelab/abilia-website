---
// Section « Hors ligne » (ancre `#offline` du menu) : l'iPhone des téléchargements, avec une
// carte de téléchargement qui se remplit au scroll et un état réseau qui bascule de « En
// ligne » à « Hors ligne » ; à côté, quatre cartes.
import FeatureCard from '../../FeatureCard.astro';
import Glyph from '../../Glyph.astro';
import PhoneFrame from '../../PhoneFrame.astro';
import Section from '../../Section.astro';
import { screenshots } from '../../../assets/screenshots';
import { type Lang, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const shot = screenshots(lang).downloads;
---

<Section id="offline" eyebrow={t('offline.eyebrow')} lead={t('offline.lead')} class="offline">
  <Fragment slot="title">{t('offline.title.1')}<br /><span class="gradient-text">{t('offline.title.2')}</span></Fragment>

  <div class="layout">
    <div class="visual" data-scroll>
      <div class="visual__glow" aria-hidden="true"></div>
      <div class="visual__phone" data-reveal="up">
        <PhoneFrame src={shot} alt={t('screenshot.downloads')} width={290} />
      </div>

      <div class="float float--status" aria-hidden="true">
        <div class="status glass" data-reveal="left" data-reveal-delay="200">
          <span class="status__state status__state--on"><Glyph name="wifi" size={18} />{t('offline.status.online')}</span>
          <span class="status__state status__state--off"><Glyph name="plane" size={18} />{t('offline.status.offline')}</span>
        </div>
      </div>

      <div class="float float--download" aria-hidden="true">
        <div class="download glass" data-reveal="right" data-reveal-delay="350">
          <span class="download__art"><Glyph name="heart" size={22} /></span>
          <span class="download__text">
            <strong>{t('offline.progress.title')}</strong>
            <span>{t('offline.progress.detail')}</span>
          </span>
          <span class="download__icon">
            <Glyph name="download" size={18} class="download__arrow" />
            <svg class="download__check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </span>
          <span class="download__bar"><span></span></span>
        </div>
      </div>
    </div>

    <div class="cards" data-reveal-stagger="110">
      <FeatureCard icon="refresh" tone="teal" title={t('offline.sync.title')} text={t('offline.sync.text')} data-reveal />
      <FeatureCard icon="drive" tone="indigo" title={t('offline.cache.title')} text={t('offline.cache.text')} data-reveal />
      <FeatureCard icon="plane" tone="coral" title={t('offline.mode.title')} text={t('offline.mode.text')} data-reveal />
      <FeatureCard icon="sliders" tone="purple" title={t('offline.quality.title')} text={t('offline.quality.text')} data-reveal />
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 88px);
  }

  .visual {
    /* Le téléchargement avance pendant la traversée ; il est complet sans JavaScript. */
    --fill: clamp(0, (var(--progress, 1) - 0.2) * 2.4, 1);
    --offline: clamp(0, (var(--progress, 1) - 0.55) * 8, 1);
    position: relative;
    display: grid;
    justify-items: center;
    padding-block: 40px;
  }

  .visual__glow {
    position: absolute;
    inset: 10% 0;
    background:
      radial-gradient(closest-side at 35% 40%, var(--halo-teal), transparent),
      radial-gradient(closest-side at 70% 70%, var(--halo-indigo), transparent);
    z-index: -1;
  }

  .float {
    position: absolute;
  }

  .float--status {
    top: 6%;
    left: 0;
  }

  .float--download {
    bottom: 14%;
    right: -4%;
    width: min(290px, 92%);
  }

  .status {
    display: grid;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.92rem;
    font-weight: 650;
  }

  .status__state {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status__state--on {
    color: var(--teal-text);
    opacity: calc(1 - var(--offline));
  }

  .status__state--off {
    color: var(--coral-text);
    opacity: var(--offline);
  }

  .download {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 4px 12px;
    padding: 14px 16px 16px;
    border-radius: 22px;
  }

  .download__art {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    color: #ff4d6d;
    background: color-mix(in srgb, #ff4d6d 16%, transparent);
  }

  .download__art :global(.glyph) {
    fill: currentColor;
  }

  .download__text {
    display: grid;
    line-height: 1.25;
  }

  .download__text span {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .download__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--teal);
    background: color-mix(in srgb, var(--teal) 15%, transparent);
  }

  .download__icon > :global(*) {
    grid-area: 1 / 1;
  }

  .download__icon :global(.download__arrow) {
    opacity: calc(1 - clamp(0, (var(--fill) - 0.98) * 50, 1));
  }

  .download__check {
    opacity: clamp(0, (var(--fill) - 0.98) * 50, 1);
  }

  .download__bar {
    grid-column: 1 / -1;
    height: 6px;
    margin-top: 10px;
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }

  .download__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--teal), var(--indigo));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .download__bar span {
      transform: scaleX(var(--fill));
    }

    .visual__phone {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * -50px)) rotate(calc((var(--progress, 0.5) - 0.5) * -4deg));
    }

    .float--download {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * 70px));
    }

    .float--status {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * -40px));
    }
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .visual {
      max-width: 440px;
      width: 100%;
      margin-inline: auto;
    }

    .visual__phone {
      --phone-width: min(260px, 66vw);
    }
  }

  @media (max-width: 600px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .float--download {
      right: 0;
    }
  }
</style>
