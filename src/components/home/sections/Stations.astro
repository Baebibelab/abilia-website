---
// Section « Stations et mix » : deux rangées de cartes aux dégradés vifs (comme les
// `StationCard` de l'app) qui glissent en sens contraires au scroll, sur toute la largeur de
// l'écran, puis trois cartes : radio, lecture continue, radios en direct.
// Les rangées ne débordent et ne glissent qu'avec JavaScript et sans « Réduire les
// animations » ; sinon les cartes passent à la ligne et leur copie décorative est masquée.
import FeatureCard from '../../FeatureCard.astro';
import Glyph from '../../Glyph.astro';
import Section from '../../Section.astro';
import { type Lang, type UIKey, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type Card = { key: UIKey; icon: Parameters<typeof Glyph>[0]['name']; from: string; to: string };

const stations: Card[] = [
  { key: 'stations.random', icon: 'shuffle', from: '#ff8a5c', to: '#d93a5b' },
  { key: 'stations.forgotten', icon: 'history', from: '#9b5de5', to: '#4b33c4' },
  { key: 'stations.never', icon: 'sparkles', from: '#2ec4b6', to: '#17707a' },
  { key: 'stations.decade80', icon: 'disc', from: '#f15bb5', to: '#8f2aa3' },
  { key: 'stations.decade90', icon: 'disc', from: '#4f6df5', to: '#33139a' },
  { key: 'stations.decade00', icon: 'disc', from: '#f39c3d', to: '#d2452a' },
];

const moods: Card[] = [
  { key: 'stations.mood.happy', icon: 'sun', from: '#8bc34a', to: '#2e6b1f' },
  { key: 'stations.mood.evening', icon: 'moon', from: '#6a5ae0', to: '#26247f' },
  { key: 'stations.mood.chill', icon: 'leaf', from: '#45b08c', to: '#1f6470' },
  { key: 'stations.mood.melancholy', icon: 'rain', from: '#6d8bab', to: '#2b3a57' },
  { key: 'stations.mood.energy', icon: 'bolt', from: '#ff6b4a', to: '#c72857' },
  { key: 'stations.mood.focus', icon: 'target', from: '#4d9de0', to: '#244f94' },
];

const rows = [
  { label: t('stations.rowStations'), cards: stations, direction: -1 },
  { label: t('stations.rowMoods'), cards: moods, direction: 1 },
];
---

<Section id="stations" eyebrow={t('stations.eyebrow')} lead={t('stations.lead')} class="stations">
  <Fragment slot="title">{t('stations.title.1')}<br /><span class="gradient-text">{t('stations.title.2')}</span></Fragment>

  <div class="rows" data-scroll>
    {
      rows.map((row) => (
        <div class="row" style={`--direction: ${row.direction}`} data-reveal="up">
          <h3 class="row__label">
            {row.label}
          </h3>
          <div class="row__track">
            <ul class="row__cards" role="list">
              {row.cards.map((card) => (
                <li class="card" style={`--from: ${card.from}; --to: ${card.to}`}>
                  <Glyph name={card.icon} size={26} />
                  <span>{t(card.key)}</span>
                </li>
              ))}
            </ul>
            <ul class="row__cards row__cards--copy" role="list" aria-hidden="true">
              {row.cards.map((card) => (
                <li class="card" style={`--from: ${card.from}; --to: ${card.to}`}>
                  <Glyph name={card.icon} size={26} />
                  <span>{t(card.key)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>

  <p class="note" data-reveal="fade">{t('stations.moodsNote')}</p>

  <div class="card-row" data-reveal-stagger="110">
    <FeatureCard icon="radio" tone="purple" title={t('stations.radio.title')} text={t('stations.radio.text')} data-reveal />
    <FeatureCard icon="infinity" tone="teal" title={t('stations.continue.title')} text={t('stations.continue.text')} data-reveal />
    <FeatureCard icon="globe" tone="coral" title={t('stations.live.title')} text={t('stations.live.text')} data-reveal />
  </div>
</Section>

<style>
  .row + .row {
    margin-top: 28px;
  }

  .row__label {
    margin-bottom: 14px;
    font-size: 1.35rem;
    font-weight: 750;
  }

  .row__track {
    display: flex;
    gap: 16px;
  }

  .row__cards {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row__cards--copy {
    display: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    width: 196px;
    min-height: 128px;
    padding: 18px;
    border-radius: 22px;
    color: #fff;
    font-weight: 650;
    line-height: 1.25;
    background: linear-gradient(145deg, var(--from), var(--to));
    box-shadow: 0 18px 40px -22px var(--to);
    overflow: hidden;
  }

  /* Reflet en haut de carte, comme un verre posé sur le dégradé. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.28), transparent 45%);
    pointer-events: none;
  }

  /* Avec JavaScript et du mouvement : rangées d'une seule ligne, sur toute la largeur de
     l'écran, qui glissent en sens contraires pendant le scroll. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .rows {
      width: 100vw;
      margin-inline: calc(50% - 50vw);
      overflow: hidden;
      padding-block: 8px 28px;
    }

    :global(html.js) .row__label {
      width: min(100% - 2 * var(--gutter), var(--content-width));
      margin-inline: auto;
    }

    :global(html.js) .row__track {
      width: max-content;
      margin-left: 50%;
      transform: translateX(calc(-50% + (var(--progress, 0.5) - 0.5) * var(--direction) * 360px));
    }

    :global(html.js) .row__cards {
      flex-wrap: nowrap;
    }

    :global(html.js) .row__cards--copy {
      display: flex;
    }
  }

  .note {
    margin-top: 20px;
    text-align: start;
  }

  .card-row {
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (max-width: 480px) {
    .card {
      width: 156px;
      min-height: 112px;
      padding: 15px;
      font-size: 0.95rem;
    }
  }
</style>
