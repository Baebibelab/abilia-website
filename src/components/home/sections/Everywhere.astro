---
// Section « Partout » (ancre `#everywhere` du menu) : l'Apple Watch et CarPlay dessinés en CSS
// (pas d'image d'Apple), chacun dans sa carte, qui flottent au scroll ; puis une rangée de
// pastilles pour le reste du système. CarPlay porte « Bientôt » tant que `CARPLAY_AVAILABLE`
// (src/config.ts) est faux.
import DeviceCard from '../../DeviceCard.astro';
import Glyph from '../../Glyph.astro';
import Section from '../../Section.astro';
import { CARPLAY_AVAILABLE } from '../../../config';
import { type Lang, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const carTabs = [t('everywhere.home'), t('everywhere.albums'), t('everywhere.artists'), t('everywhere.playlists')];
const carRows = [
  { icon: 'heart', label: t('everywhere.favorites') },
  { icon: 'library', label: t('everywhere.genres') },
  { icon: 'sparkles', label: t('everywhere.recent') },
  { icon: 'history', label: t('everywhere.played') },
] as const;

const system = [
  { icon: 'lockScreen', label: t('everywhere.lockScreen') },
  { icon: 'airplay', label: t('everywhere.airplay') },
  { icon: 'widget', label: t('everywhere.widget') },
  { icon: 'mic', label: t('everywhere.siri') },
  { icon: 'accessibility', label: t('everywhere.a11y') },
] as const;
---

<Section id="everywhere" eyebrow={t('everywhere.eyebrow')} lead={t('everywhere.lead')} align="center" class="everywhere">
  <Fragment slot="title">{t('everywhere.title.1')}<br /><span class="gradient-text">{t('everywhere.title.2')}</span></Fragment>

  <div class="duo" data-scroll data-loop>
    <DeviceCard
      icon="watch"
      title={t('everywhere.watch.title')}
      text={t('everywhere.watch.text')}
      halo="coral"
      haloAt="30% 30%"
      decorative
      visualClass="watch-visual"
      data-reveal="up"
    >
      <div class="watch">
        <span class="watch__band watch__band--top"></span>
        <span class="watch__band watch__band--bottom"></span>
        <span class="watch__crown"></span>
        <div class="watch__body">
          <div class="watch__screen">
            <p class="watch__title">{t('everywhere.watchList')}</p>
            <div class="watch__row">
              <span class="watch__art watch__art--heart"><Glyph name="heart" size={14} /></span>
              <span class="watch__name">{t('everywhere.favorites')}</span>
            </div>
            <div class="watch__row">
              <span class="watch__art" style="--a: #ff6b4a; --b: #bf5af2"></span>
              <span class="watch__lines"><i></i><i></i></span>
            </div>
            <div class="watch__row">
              <span class="watch__art" style="--a: #2e8888; --b: #5e5ce6"></span>
              <span class="watch__lines"><i></i><i></i></span>
            </div>
            <div class="watch__eq"><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </DeviceCard>

    <DeviceCard
      icon="car"
      title={t('everywhere.carplay.title')}
      text={t('everywhere.carplay.text')}
      soon={CARPLAY_AVAILABLE ? null : t('everywhere.soon')}
      haloAt="75% 30%"
      decorative
      data-reveal="up"
      data-reveal-delay="120"
    >
      <div class="car">
        <div class="car__sidebar">
          <span class="car__time">9:41</span>
          <span class="car__app"></span>
          <span class="car__app car__app--2"></span>
          <span class="car__app car__app--3"></span>
        </div>
        <div class="car__main">
          <div class="car__tabs">
            {carTabs.map((tab, i) => <span class:list={{ 'is-active': i === 0 }}>{tab}</span>)}
          </div>
          <ul class="car__list">
            {
              carRows.map((row) => (
                <li>
                  <Glyph name={row.icon} size={16} />
                  {row.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </DeviceCard>
  </div>

  <ul class="system" role="list" data-reveal-stagger="80">
    {
      system.map((item) => (
        <li class="glass" data-reveal="scale">
          <Glyph name={item.icon} size={20} />
          {item.label}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 22px;
  }

  /* La montre déborde de son visuel au scroll : coupée par lui, plus d'air au-dessus et dessous. */
  .duo :global(.watch-visual) {
    overflow: clip;
    padding-block: 64px;
  }

  /* Apple Watch dessinée : boîtier, couronne, bracelet, et la liste de ce qui est sur la montre. */
  .watch {
    position: relative;
    width: 184px;
    aspect-ratio: 41 / 49;
  }

  /* Le bracelet s'efface vers ses bouts : il ne déborde jamais sur le texte de la carte. */
  .watch__band {
    position: absolute;
    left: 14%;
    right: 14%;
    height: 40%;
    background: linear-gradient(90deg, #2c2f36, #474b55 50%, #2c2f36);
    z-index: -1;
  }

  .watch__band--top {
    bottom: 80%;
    border-radius: 18px 18px 6px 6px;
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
    mask-image: linear-gradient(to top, #000 55%, transparent);
  }

  .watch__band--bottom {
    top: 80%;
    border-radius: 6px 6px 18px 18px;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }

  .watch__crown {
    position: absolute;
    right: -7px;
    top: 26%;
    width: 9px;
    height: 34px;
    border-radius: 4px;
    background: linear-gradient(90deg, #5b5f68, #2a2c31);
  }

  .watch__body {
    height: 100%;
    padding: 9px;
    border-radius: 38px;
    background: linear-gradient(145deg, #4a4d55, #16171b 45%, #33363d);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.16),
      0 30px 50px -24px rgb(0 0 0 / 0.6);
  }

  .watch__screen {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 14px 12px;
    border-radius: 30px;
    background: #000;
    color: #fff;
    font-size: 0.72rem;
    overflow: hidden;
  }

  .watch__title {
    color: #6dc2b8;
    font-weight: 700;
    font-size: 0.78rem;
  }

  .watch__row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.1);
  }

  .watch__art {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(145deg, var(--a), var(--b));
  }

  .watch__art--heart {
    color: #ff4d6d;
    background: rgb(255 77 109 / 0.2);
  }

  .watch__art--heart :global(.glyph) {
    fill: currentColor;
  }

  .watch__name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .watch__lines {
    display: grid;
    gap: 4px;
    flex: 1;
  }

  .watch__lines i {
    height: 5px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.5);
  }

  .watch__lines i + i {
    width: 60%;
    background: rgb(255 255 255 / 0.25);
  }

  .watch__eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
    margin-top: auto;
    margin-inline: auto;
  }

  .watch__eq i {
    width: 4px;
    height: 100%;
    border-radius: 2px;
    background: #6dc2b8;
    transform-origin: bottom;
  }

  .watch__eq i:nth-child(2) {
    height: 60%;
  }

  .watch__eq i:nth-child(3) {
    height: 85%;
  }

  .watch__eq i:nth-child(4) {
    height: 45%;
  }

  /* CarPlay dessiné : barre latérale, onglets en haut et l'accueil d'Andia. */
  .car {
    display: grid;
    grid-template-columns: 54px 1fr;
    width: min(460px, 100%);
    aspect-ratio: 16 / 8.5;
    padding: 8px;
    border-radius: 22px;
    background: linear-gradient(160deg, #2a2d33, #0e0f12);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.12),
      0 30px 60px -30px rgb(0 0 0 / 0.7);
    color: #fff;
    overflow: hidden;
  }

  .car__sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 8px;
    border-radius: 14px 0 0 14px;
    background: #17181c;
  }

  .car__time {
    font-size: 0.72rem;
    font-weight: 700;
  }

  .car__app {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: linear-gradient(145deg, #ff6b4a, #f2542f);
  }

  .car__app--2 {
    background: linear-gradient(145deg, #6dc2b8, #2e8888);
  }

  .car__app--3 {
    background: linear-gradient(145deg, #5e5ce6, #af52de);
  }

  .car__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 8px 12px;
    border-radius: 0 14px 14px 0;
    background: #000;
  }

  .car__tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.6);
  }

  .car__tabs span {
    padding: 4px 9px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .car__tabs .is-active {
    color: #fff;
    background: rgb(255 255 255 / 0.18);
  }

  .car__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }

  .car__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 4px;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    white-space: nowrap;
  }

  .car__list :global(.glyph) {
    color: #6dc2b8;
  }

  @media (prefers-reduced-motion: no-preference) {
    .watch {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * -50px)) rotate(calc((var(--progress, 0.5) - 0.5) * 8deg));
    }

    .car {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * 40px)) perspective(900px)
        rotateY(calc((var(--progress, 0.5) - 0.5) * -14deg));
    }

    .watch__eq i {
      animation: eq 0.9s ease-in-out infinite alternate;
    }

    .watch__eq i:nth-child(2) {
      animation-delay: -0.3s;
    }

    .watch__eq i:nth-child(3) {
      animation-delay: -0.6s;
    }

    .watch__eq i:nth-child(4) {
      animation-delay: -0.15s;
    }

    @keyframes eq {
      from {
        transform: scaleY(0.3);
      }
    }
  }

  .system {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .system li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px 11px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 550;
  }

  .system :global(.glyph) {
    color: var(--teal);
  }

  @media (max-width: 900px) {
    .duo {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin-inline: auto;
    }
  }

  @media (max-width: 480px) {
    .duo :global(.watch-visual) {
      padding-block: 56px;
    }

    .car {
      grid-template-columns: 40px 1fr;
    }

    .car__tabs {
      justify-content: flex-start;
      overflow: hidden;
    }

    .car__tabs span {
      padding: 3px 6px;
    }

    .car__app {
      width: 22px;
      height: 22px;
    }

    /* L'écran garde ses proportions : la liste se resserre pour y tenir en entier. */
    .car__main {
      gap: 3px;
      padding: 6px 10px;
    }

    .car__list {
      font-size: 0.74rem;
    }

    .car__list li {
      gap: 8px;
      padding: 5px 2px;
    }

    .system li {
      font-size: 0.88rem;
    }
  }
  /* Écran étroit (iPhone SE…) : un écran de voiture un peu moins large, pour garder les quatre lignes. */
  @media (max-width: 370px) {
    .car {
      aspect-ratio: 16 / 10;
    }
  }
</style>
