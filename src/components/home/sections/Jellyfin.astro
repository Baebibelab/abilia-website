---
// Section « Votre serveur Jellyfin » (ancre `#features` du menu) : le serveur relié à l'iPhone
// par un fil lumineux qui se trace au scroll, des pastilles qui flottent à des profondeurs
// différentes, puis trois cartes et le lien vers Jellyfin.
import FeatureCard from '../../FeatureCard.astro';
import Glyph from '../../Glyph.astro';
import PhoneFrame from '../../PhoneFrame.astro';
import Section from '../../Section.astro';
import shot from '../../../assets/screenshots/bibliotheque.jpg';
import { JELLYFIN_URL } from '../../../config';
import { type Lang, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Pastilles autour de l'iPhone : position dans la scène et profondeur de parallaxe (px).
const chips = [
  { icon: 'home', label: t('jellyfin.chip.home'), detail: '192.168.1.10:8096', class: 'chip--a', depth: 90 },
  { icon: 'globe', label: t('jellyfin.chip.away'), detail: 'https://', class: 'chip--b', depth: -70 },
  { icon: 'lock', label: t('jellyfin.chip.keychain'), class: 'chip--c', depth: 130 },
  { icon: 'shield', label: t('jellyfin.chip.noAccount'), class: 'chip--d', depth: -110 },
] as const;
---

<Section id="features" eyebrow={t('jellyfin.eyebrow')} lead={t('jellyfin.lead')} align="center" class="jellyfin">
  <Fragment slot="title">{t('jellyfin.title.1')}<br /><span class="gradient-text">{t('jellyfin.title.2')}</span></Fragment>

  <div class="stage" data-scroll data-loop>
    <div class="server glass" data-reveal="right">
      <span class="server__icon"><Glyph name="server" size={28} /></span>
      <span class="server__name">Jellyfin</span>
      <span class="server__leds" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    <svg class="wire" viewBox="0 0 400 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="wire-gradient" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="var(--purple)"></stop>
          <stop offset="0.5" stop-color="var(--coral)"></stop>
          <stop offset="1" stop-color="var(--teal)"></stop>
        </linearGradient>
      </defs>
      <path class="wire__track" d="M0 100 C 140 100, 180 40, 400 60" pathLength="1"></path>
      <path class="wire__line" d="M0 100 C 140 100, 180 40, 400 60" pathLength="1"></path>
      <path class="wire__pulse" d="M0 100 C 140 100, 180 40, 400 60" pathLength="1"></path>
    </svg>

    <span class="connector" aria-hidden="true"></span>

    <div class="device" data-reveal="scale">
      <PhoneFrame src={shot} alt={t('screenshot.library')} width={290} />
    </div>

    <ul class="chips" role="list">
      {
        chips.map((chip, index) => (
          <li class:list={['chip', chip.class]} style={`--depth: ${chip.depth}px`}>
            <span class="chip__body glass" data-reveal="fade" data-reveal-delay={String(300 + index * 120)}>
              <Glyph name={chip.icon} size={18} />
              <span>
                <strong>{chip.label}</strong>
                {'detail' in chip && <code>{chip.detail}</code>}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="cards" data-reveal-stagger="110">
    <FeatureCard icon="library" tone="teal" title={t('jellyfin.library.title')} text={t('jellyfin.library.text')} data-reveal />
    <FeatureCard icon="search" tone="indigo" title={t('jellyfin.search.title')} text={t('jellyfin.search.text')} data-reveal />
    <FeatureCard icon="lock" tone="coral" title={t('jellyfin.secure.title')} text={t('jellyfin.secure.text')} data-reveal />
  </div>

  <p class="note" data-reveal>
    {t('jellyfin.note')} <a href={JELLYFIN_URL} rel="noopener">{t('jellyfin.noteLink')}</a>
  </p>
</Section>

<style>
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 980px;
    margin-inline: auto;
    min-height: 640px;
  }

  /* Le serveur, à gauche, relié à l'iPhone par le fil. */
  .server {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 6px 14px;
    width: min(220px, 100%);
    padding: 18px 20px;
  }

  .server__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    color: #fff;
    background: linear-gradient(145deg, var(--purple), var(--indigo));
  }

  .server__name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .server__leds {
    display: flex;
    gap: 6px;
  }

  .server__leds i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 10px var(--teal);
  }

  .server__leds i:nth-child(2) {
    background: var(--coral);
    box-shadow: 0 0 10px var(--coral);
  }

  .wire {
    position: absolute;
    left: 210px;
    right: calc(50% + 140px);
    top: 34%;
    width: auto;
    height: 200px;
    overflow: visible;
    z-index: 1;
  }

  .wire path {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .wire__track {
    stroke: var(--border);
  }

  /* Le fil se trace pendant que la section traverse l'écran (`--progress`, data-scroll). */
  .wire__line {
    stroke: url(#wire-gradient);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - min(1, max(0, (var(--progress, 1) - 0.15) * 3)));
  }

  .wire__pulse,
  .connector {
    display: none;
  }

  .device {
    grid-column: 2;
    grid-row: 1;
    z-index: 1;
  }

  .chips {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    position: absolute;
    z-index: 3;
  }

  .chip__body {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    border-radius: 18px;
    font-size: 0.92rem;
    line-height: 1.25;
    color: var(--text);
  }

  .chip :global(.glyph) {
    color: var(--teal);
  }

  .chip__body > span {
    display: grid;
  }

  .chip strong {
    font-weight: 650;
  }

  .chip code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .chip--a {
    top: 12%;
    right: 4%;
  }

  .chip--b {
    top: 44%;
    right: 0;
  }

  .chip--c {
    bottom: 16%;
    right: 8%;
  }

  .chip--d {
    bottom: 10%;
    left: 6%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .device {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * -60px));
    }

    .chip {
      transform: translateY(calc((var(--progress, 0.5) - 0.5) * var(--depth)));
    }

    /* Une impulsion lumineuse parcourt le fil en boucle, du serveur vers l'iPhone. */
    .wire__pulse {
      display: block;
      stroke: #fff;
      stroke-width: 5;
      stroke-dasharray: 0.06 1;
      opacity: calc(min(1, max(0, (var(--progress, 1) - 0.4) * 5)) * 0.9);
      filter: drop-shadow(0 0 6px var(--coral));
      animation: wire-pulse 2.6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    @keyframes wire-pulse {
      from {
        stroke-dashoffset: 0.06;
      }
      to {
        stroke-dashoffset: -1;
      }
    }

    .server__leds i {
      animation: led 1.8s ease-in-out infinite alternate;
    }

    .server__leds i:nth-child(2) {
      animation-delay: 0.6s;
    }

    .server__leds i:nth-child(3) {
      animation-delay: 1.2s;
    }

    @keyframes led {
      to {
        opacity: 0.35;
      }
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: clamp(48px, 6vw, 80px);
  }

  .note {
    margin-top: 32px;
    text-align: center;
    color: var(--text-secondary);
  }

  .note a {
    color: var(--teal-text);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }

  /* Téléphone : le serveur au-dessus de l'iPhone, un fil vertical, les pastilles en dessous. */
  @media (max-width: 760px) {
    .stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 0;
      gap: 0;
    }

    .server {
      justify-self: auto;
    }

    .wire {
      display: none;
    }

    .connector {
      display: block;
      width: 3px;
      height: 48px;
      border-radius: 3px;
      background: linear-gradient(var(--purple), var(--teal));
    }

    .device {
      --phone-width: min(260px, 72vw);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 28px;
    }

    .chip {
      position: static;
      transform: none !important;
    }
  }
</style>
