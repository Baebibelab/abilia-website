---
// Section « Moteur audio » : deux pistes en forme d'onde sur une frise. Au scroll, la seconde
// arrive et se colle à la première (sans blanc), puis la chevauche avec les courbes du fondu
// enchaîné ; une tête de lecture traverse la frise. Les deux cartes sous la frise s'allument
// avec la phase en cours. Sans mouvement (animations réduites), les pistes restent collées et
// seules les opacités suivent le scroll. Sous les cartes, « Fait maison » dit ce qu'apporte le
// moteur audio de l'app (`SampleBufferAudioEngine`) sans entrer dans la technique.
import Glyph from '../../Glyph.astro';
import Section from '../../Section.astro';
import { type Lang, useTranslations } from '../../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Formes d'onde déterministes (même rendu à chaque build) : une enveloppe douce et un peu de
// variation. La piste 1 finit sur une note tenue, la piste 2 démarre franchement : c'est le
// passage qu'un blanc couperait.
const BAR = 10;
function wave(count: number, seed: number, shape: (x: number) => number) {
  return Array.from({ length: count }, (_, i) => {
    const x = i / (count - 1);
    const jitter = 0.55 + 0.45 * Math.abs(Math.sin(i * 12.9898 + seed) * Math.cos(i * 4.1414 + seed * 2));
    return Math.max(0.08, Math.min(1, shape(x) * jitter));
  });
}
const trackA = wave(54, 1, (x) => 0.35 + 0.55 * Math.sin(Math.PI * Math.min(1, x * 1.6)) ** 0.6 * (x > 0.8 ? 0.85 : 1));
const trackB = wave(52, 7, (x) => (x < 0.04 ? 0.7 : 0.45 + 0.5 * Math.abs(Math.sin(x * 5.2))));
const HEIGHT = 180;
const MID = 110;
const A_END = trackA.length * BAR;
const FADE = 90;

const enginePoints = [
  { icon: 'play', key: 'stream' },
  { icon: 'gauge', key: 'volume' },
  { icon: 'sliders', key: 'effects' },
  { icon: 'airplay', key: 'system' },
] as const;

function bars(values: number[]) {
  return values.map((v, i) => {
    const h = v * HEIGHT;
    return { x: i * BAR, y: MID - h / 2, h };
  });
}

// Courbes à puissance constante du fondu : cosinus qui descend, sinus qui monte.
function curve(kind: 'out' | 'in', x0: number) {
  const points = Array.from({ length: 21 }, (_, i) => {
    const s = i / 20;
    const gain = kind === 'out' ? Math.cos((s * Math.PI) / 2) : Math.sin((s * Math.PI) / 2);
    return `${(x0 + s * FADE).toFixed(1)} ${(MID + HEIGHT / 2 - gain * HEIGHT).toFixed(1)}`;
  });
  return `M${points.join(' L')}`;
}
---

<Section id="gapless" eyebrow={t('gapless.eyebrow')} lead={t('gapless.lead')} align="center" class="gapless">
  <Fragment slot="title">{t('gapless.title.1')}<br /><span class="gradient-text">{t('gapless.title.2')}</span></Fragment>

  <div class="mix" data-scroll>
    <div class="mix__panel glass" data-reveal="scale">
      <svg class="mix__svg" viewBox={`-20 0 ${A_END + trackB.length * BAR + 30} 220`} role="img" aria-label={`${t('gapless.trackA')}, ${t('gapless.trackB')}`}>
        <defs>
          <linearGradient id="mix-a" gradientUnits="userSpaceOnUse" x1="0" x2={A_END} y1="0" y2="0">
            <stop offset="0" stop-color="var(--teal)"></stop>
            <stop offset="1" stop-color="var(--indigo)"></stop>
          </linearGradient>
          <linearGradient id="mix-b" gradientUnits="userSpaceOnUse" x1="0" x2={trackB.length * BAR} y1="0" y2="0">
            <stop offset="0" stop-color="var(--coral)"></stop>
            <stop offset="1" stop-color="var(--purple)"></stop>
          </linearGradient>
        </defs>

        <line class="mix__axis" x1="-20" x2={A_END + trackB.length * BAR + 10} y1={MID} y2={MID}></line>

        <g class="mix__track mix__track--a">
          {bars(trackA).map((b) => <rect x={b.x} y={b.y} width="6" height={b.h} rx="3" />)}
          <path class="mix__curve" d={curve('out', A_END - FADE)}></path>
        </g>

        <g class="mix__track mix__track--b" style={`--x0: ${A_END}px`}>
          {bars(trackB).map((b) => <rect x={b.x} y={b.y} width="6" height={b.h} rx="3" />)}
          <path class="mix__curve" d={curve('in', 0)}></path>
        </g>

        <line class="mix__seam" x1={A_END - 2} x2={A_END - 2} y1="8" y2="212"></line>
        <line class="mix__playhead" x1="0" x2="0" y1="0" y2="220"></line>
      </svg>

      <div class="mix__labels" aria-hidden="true">
        <span class="mix__label mix__label--a">{t('gapless.trackA')}</span>
        <span class="mix__label mix__label--b">{t('gapless.trackB')}</span>
      </div>
    </div>

    <div class="modes">
      <article class="mode mode--gapless glass" data-reveal="up">
        <h3>{t('gapless.gapless.title')}</h3>
        <p>{t('gapless.gapless.text')}</p>
      </article>
      <article class="mode mode--crossfade glass" data-reveal="up" data-reveal-delay="120">
        <h3>{t('gapless.crossfade.title')}</h3>
        <p>{t('gapless.crossfade.text')}</p>
      </article>
    </div>
  </div>

  <div class="engine glass" data-reveal="up">
    <div class="engine__intro">
      <p class="engine__eyebrow"><Glyph name="waveform" size={18} />{t('gapless.engine.eyebrow')}</p>
      <h3>{t('gapless.engine.title')}</h3>
      <p>{t('gapless.engine.text')}</p>
      <p class="engine__note">{t('gapless.engine.note')}</p>
    </div>
    <ul class="engine__points" role="list" data-reveal-stagger="90">
      {
        enginePoints.map((point) => (
          <li data-reveal>
            <span class="engine__badge">
              <Glyph name={point.icon} size={20} />
            </span>
            <div>
              <h4>{t(`gapless.engine.${point.key}.title`)}</h4>
              <p>{t(`gapless.engine.${point.key}.text`)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="facts" role="list" data-reveal-stagger="100">
    <li data-reveal><Glyph name="layers" size={20} />{t('gapless.fact.prepared')}</li>
    <li data-reveal><Glyph name="gauge" size={20} />{t('gapless.fact.normalized')}</li>
    <li data-reveal><Glyph name="moonZ" size={20} />{t('gapless.fact.sleep')}</li>
  </ul>
</Section>

<style>
  .mix {
    /* Phase 1 : la piste 2 arrive et se colle ; phase 2 : elle chevauche (fondu). Sans
       JavaScript, la frise reste sur la fin de la phase 1. */
    --p: var(--progress, 0.47);
    --a: clamp(0, (var(--p) - 0.18) * 4, 1);
    --b: clamp(0, (var(--p) - 0.5) * 5, 1);
    max-width: 1000px;
    margin-inline: auto;
  }

  .mix__panel {
    position: relative;
    padding: clamp(16px, 3vw, 36px) clamp(12px, 3vw, 36px) clamp(44px, 5vw, 56px);
    overflow: hidden;
  }

  .mix__svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mix__axis {
    stroke: var(--border);
    stroke-width: 2;
  }

  .mix__track--a rect {
    fill: url(#mix-a);
  }

  .mix__track--b rect {
    fill: url(#mix-b);
  }

  .mix__track--b {
    transform: translateX(var(--x0));
  }

  .mix__curve {
    fill: none;
    stroke: var(--text);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 8 7;
    opacity: calc(var(--b) * 0.75);
  }

  /* La jonction s'éclaire quand les pistes se touchent, sans blanc. */
  .mix__seam {
    stroke: var(--coral);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: calc(var(--a) * (1 - var(--b)));
    filter: drop-shadow(0 0 6px var(--coral));
  }

  .mix__playhead {
    display: none;
    stroke: var(--text);
    stroke-width: 2;
    opacity: 0.5;
  }

  .mix__labels {
    position: absolute;
    left: clamp(12px, 3vw, 36px);
    right: clamp(12px, 3vw, 36px);
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .mix__label::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--teal), var(--indigo));
  }

  .mix__label--b::before {
    background: linear-gradient(90deg, var(--coral), var(--purple));
  }

  @media (prefers-reduced-motion: no-preference) {
    .mix__track--b {
      transform: translateX(calc(var(--x0) + (1 - var(--a)) * 300px - var(--b) * 90px));
    }

    .mix__seam {
      transform: translateX(calc(var(--b) * -45px));
    }

    .mix__playhead {
      display: block;
      transform: translateX(calc(40px + var(--p) * 960px));
    }
  }

  .modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }

  .mode {
    --on: calc(var(--a) * (1 - var(--b)));
    display: grid;
    gap: 8px;
    padding: 22px 24px;
    text-align: start;
    border-color: color-mix(in srgb, var(--coral) calc(var(--on) * 70%), var(--glass-border));
  }

  .mode--crossfade {
    --on: var(--b);
    border-color: color-mix(in srgb, var(--purple) calc(var(--on) * 70%), var(--glass-border));
  }

  .mode h3 {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .mode h3::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border-radius: 50%;
    vertical-align: 0.1em;
    background: var(--coral);
    box-shadow: 0 0 calc(var(--on) * 14px) var(--coral);
    opacity: calc(0.35 + var(--on) * 0.65);
  }

  .mode--crossfade h3::before {
    background: var(--purple);
    box-shadow: 0 0 calc(var(--on) * 14px) var(--purple);
  }

  .mode p {
    color: var(--text-secondary);
  }

  .engine {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    max-width: 1000px;
    margin: 20px auto 0;
    padding: clamp(24px, 4vw, 44px);
    text-align: start;
  }

  .engine__intro {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .engine__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--teal-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .engine__intro h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .engine__intro p:not(.engine__eyebrow) {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .engine__intro .engine__note {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .engine__points {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .engine__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    align-items: start;
  }

  .engine__badge {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(145deg, var(--teal-strong), color-mix(in srgb, var(--teal-strong) 72%, #000));
  }

  .engine__points li:nth-child(2) .engine__badge {
    background: linear-gradient(145deg, var(--coral), color-mix(in srgb, var(--coral) 72%, #000));
  }

  .engine__points li:nth-child(3) .engine__badge {
    background: linear-gradient(145deg, var(--purple-strong), color-mix(in srgb, var(--purple-strong) 72%, #000));
  }

  .engine__points li:nth-child(4) .engine__badge {
    background: linear-gradient(145deg, var(--indigo), color-mix(in srgb, var(--indigo) 72%, #000));
  }

  .engine__points h4 {
    margin: 8px 0 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .engine__points p {
    margin: 4px 0 0;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .facts :global(.glyph) {
    color: var(--teal);
  }

  @media (max-width: 860px) {
    .engine {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .modes {
      grid-template-columns: 1fr;
    }

    .facts {
      flex-direction: column;
      align-items: flex-start;
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
