---
// Accueil, commun aux deux langues (src/pages/index.astro et src/pages/en/index.astro).
// Chaque bloc est son propre fichier, pour que le hero et les sections évoluent séparément :
// Hero.astro, puis sections/*.astro, dans l'ordre de lecture.
import Hero from './Hero.astro';
import BigScreens from './sections/BigScreens.astro';
import Everywhere from './sections/Everywhere.astro';
import Gapless from './sections/Gapless.astro';
import Jellyfin from './sections/Jellyfin.astro';
import Listen from './sections/Listen.astro';
import Offline from './sections/Offline.astro';
import Rewind from './sections/Rewind.astro';
import Stations from './sections/Stations.astro';
import { IPAD_AVAILABLE, MAC_AVAILABLE } from '../../config';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// « iPad et Mac » attend la sortie d'au moins une des deux (src/config.ts), sauf en développement.
const showsBigScreens = IPAD_AVAILABLE || MAC_AVAILABLE || import.meta.env.DEV;
---

<Hero lang={lang} />
<Jellyfin lang={lang} />
<Listen lang={lang} />
<Gapless lang={lang} />
<Stations lang={lang} />
<Offline lang={lang} />
<Rewind lang={lang} />
{showsBigScreens && <BigScreens lang={lang} />}
<Everywhere lang={lang} />
