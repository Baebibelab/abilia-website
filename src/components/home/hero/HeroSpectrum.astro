---
// Grand spectre lumineux derrière l'iPhone du hero, aux couleurs de la marque (corail → violet
// → sarcelle). Animation 100 % CSS : chaque barre oscille entre trois hauteurs à son propre
// rythme, si bien que l'ensemble ne se répète jamais à l'œil, et l'animation tourne aussi sans
// JavaScript. Avec « Réduire les animations », les barres restent figées à mi-hauteur.
import { round, seededRandom } from './random';

interface Props {
  /** Nombre de barres (réparties sur toute la largeur). */
  count?: number;
}

const { count = 56 } = Astro.props;
const random = seededRandom(1984);
const phase = random() * Math.PI * 2;

const bars = Array.from({ length: count }, (_, index) => {
  const t = index / (count - 1);
  // Enveloppe douce (deux sinusoïdes), pour des « collines » plutôt qu'un bruit uniforme.
  const envelope = 0.55 + 0.25 * Math.sin(t * Math.PI * 3 + phase) + 0.2 * Math.sin(t * Math.PI * 7.3 + phase * 2);
  const level = () => round(Math.min(1, Math.max(0.12, envelope * (0.35 + random() * 0.75))));
  const color =
    t < 0.5
      ? `color-mix(in oklab, var(--coral) ${round((1 - t * 2) * 100)}%, var(--purple))`
      : `color-mix(in oklab, var(--purple) ${round((2 - t * 2) * 100)}%, var(--teal))`;
  return [
    `--a: ${level()}`,
    `--b: ${level()}`,
    `--c: ${level()}`,
    `--d: ${round(0.9 + random() * 0.9)}s`,
    `--delay: ${round(-random() * 2)}s`,
    `--bar: ${color}`,
  ].join('; ');
});
---

<div class="hero-spectrum" aria-hidden="true">
  <div class="hero-spectrum__bars">
    {bars.map((style) => <span class="hero-spectrum__bar" style={style} />)}
  </div>
</div>

<style>
  .hero-spectrum {
    position: absolute;
    inset-inline: 0;
    height: var(--spectrum-height, clamp(140px, 22vw, 300px));
    pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  .hero-spectrum__bars {
    display: flex;
    gap: clamp(3px, 0.55vw, 9px);
    height: 100%;
    align-items: center;
    padding-inline: 2vw;
  }

  .hero-spectrum__bar {
    flex: 1;
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, transparent, var(--bar) 30%, var(--bar) 70%, transparent);
    opacity: 0.7;
    transform: scaleY(var(--b));
  }

  @media (prefers-color-scheme: dark) {
    .hero-spectrum__bar {
      opacity: 0.75;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-spectrum__bar {
      animation: hero-spectrum-level var(--d) ease-in-out var(--delay) infinite alternate;
    }

    /* À l'arrivée, le spectre s'ouvre depuis sa ligne médiane. */
    :global(html.js) .hero-spectrum__bars {
      animation: hero-spectrum-in 1.6s var(--ease-out) 0.35s backwards;
    }
  }

  @keyframes hero-spectrum-level {
    0% {
      transform: scaleY(var(--a));
    }
    50% {
      transform: scaleY(var(--b));
    }
    100% {
      transform: scaleY(var(--c));
    }
  }

  @keyframes hero-spectrum-in {
    from {
      opacity: 0;
      transform: scaleY(0.05);
    }
  }
</style>
