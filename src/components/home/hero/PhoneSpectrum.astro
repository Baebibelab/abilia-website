---
// Les barres du spectre de l'écran En lecture, posées sur la capture (`en-lecture.jpg`, la même
// mise en page en français et en anglais) à l'endroit exact de sa rangée de points : 24 barres arrondies, blanches à 55 %, qui montent
// depuis le bas sur 28 pt, comme `SpectrumBars` dans l'app. Un aplat de la couleur du fond
// de l'écran efface les points de la capture, que les barres remplacent.
//
// Mesures en pixels de la capture (590 × 1278) : rangée de x = 88 à 502, bas des points à
// y = 692,5, 42 px de haut (28 pt × 1,5). Les niveaux figés servent sans JavaScript et avec
// « Réduire les animations » ; le script du hero les anime ensuite (`data-hero-bar`).
import { BAND_COUNT, STILL_TIME, spectrumAt } from './spectrum';

const levels = spectrumAt(STILL_TIME);
---

<div class="screen-overlay" aria-hidden="true">
  <span class="dots-cover"></span>
  <div class="bars">
    {
      Array.from({ length: BAND_COUNT }, (_, i) => (
        <span class="bar">
          <span class="cap" data-hero-bar={i} style={`--level: ${levels[i].toFixed(3)}`} />
        </span>
      ))
    }
  </div>
</div>

<style>
  /* Même boîte que l'image affichée (`object-fit: cover`, centrée) : les pourcentages sont
     ceux de la capture. */
  .screen-overlay {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: 590 / 1278;
    translate: -50% 0;
    pointer-events: none;
  }

  .dots-cover {
    position: absolute;
    left: calc(84 / 590 * 100%);
    width: calc(422 / 590 * 100%);
    top: calc(677 / 1278 * 100%);
    height: calc(19 / 1278 * 100%);
    border-radius: 999px;
    background: rgb(146 20 36);
  }

  .bars {
    position: absolute;
    left: calc(88 / 590 * 100%);
    width: calc(414 / 590 * 100%);
    top: calc(650.5 / 1278 * 100%);
    height: calc(42 / 1278 * 100%);
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    column-gap: calc(4.5 / 414 * 100%);
  }

  .bar {
    overflow: hidden;
    border-radius: 999px;
    /* Le bord arrondi du bas ne doit pas déborder pendant que la barre bouge. */
    isolation: isolate;
  }

  /* La barre visible = ce qui dépasse de la piste : au repos un rond (sa largeur fait 30 % de
     la hauteur), au maximum toute la hauteur. */
  .cap {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    transform: translateY(calc((1 - max(0.304, 0.06 + 0.94 * var(--level, 0))) * 100%));
    will-change: transform;
  }
</style>
