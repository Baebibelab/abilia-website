---
// Gabarit de toutes les pages : <head> (titre, description, canonique, hreflang, Open Graph),
// fond animé, en-tête, contenu, pied de page, et le moteur d'animation au scroll.
import '../styles/global.css';
import '../styles/motion.css';
import Footer from '../components/Footer.astro';
import Halos from '../components/Halos.astro';
import Header from '../components/Header.astro';
import { APP_LANGUAGES, APP_STORE_ID, APP_STORE_URL } from '../config';
import { type Lang, defaultLang, languages, routes, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Adresse de cette page dans chaque langue (voir `routes` dans src/i18n/ui.ts). */
  alternates: Record<Lang, string>;
  title?: string;
  description?: string;
  /**
   * Pages qui ne doivent pas être indexées (404…) : ni canonique, ni hreflang, ni `og:url`, ni
   * fiche schema.org, qui les donneraient pour une autre page. Le sélecteur de langue garde
   * `alternates`.
   */
  noindex?: boolean;
}

const { lang, alternates, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · Andia` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(alternates[lang], site).href;
const ogLocale = { fr: 'fr_FR', en: 'en_US' } satisfies Record<Lang, string>;
// Images de partage rendues par scripts/og/render.mjs (une par langue, 1200 × 630).
const ogImage = new URL(`/og/andia-${lang}.jpg`, site).href;

// Fiche de l'app pour les moteurs de recherche (schema.org), sur l'accueil seulement (la 404 passe
// les adresses de l'accueil à `alternates`, d'où le `noindex`).
const isHome = !noindex && alternates[lang] === routes.home[lang];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Andia',
  url: canonical,
  description: pageDescription,
  image: new URL('/apple-touch-icon.png', site).href,
  operatingSystem: 'iOS 17, watchOS 10',
  applicationCategory: 'MultimediaApplication',
  inLanguage: APP_LANGUAGES,
  // L'app est gratuite (Andia Plus s'achète dans l'app) : une offre à 0, disponible le jour où
  // APP_STORE_URL est renseigné, indisponible jusque-là (pas « PreOrder » : rien ne se précommande).
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: APP_STORE_URL ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    ...(APP_STORE_URL ? { url: APP_STORE_URL } : {}),
  },
  ...(APP_STORE_URL ? { downloadUrl: APP_STORE_URL, installUrl: APP_STORE_URL } : {}),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {(Object.keys(languages) as Lang[]).map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(alternates[l], site).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], site).href} />
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
    <meta name="theme-color" content="#f4f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07080b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andia" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      (Object.keys(languages) as Lang[])
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('meta.ogImageAlt')} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!-- Avant tout rendu : les états de départ des animations ne s'appliquent qu'avec JavaScript. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Halos />
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    outline: none;
  }
</style>
