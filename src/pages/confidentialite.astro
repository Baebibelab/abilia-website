---
import PrivacyPage from '../components/privacy/PrivacyPage.astro';
import { Content, frontmatter, getHeadings } from '../content/privacy/fr.md';
import Base from '../layouts/Base.astro';
import { routes, useTranslations } from '../i18n/ui';

const t = useTranslations('fr');
---

<Base lang="fr" alternates={routes.privacy} title={t('privacy.title')} description={t('privacy.description')}>
  <PrivacyPage lang="fr" updated={frontmatter.updated} headings={getHeadings()}>
    <Content />
  </PrivacyPage>
</Base>
