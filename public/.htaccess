# Configuration Apache du VPS OVH (copiée à la racine du site par le build ; le VirtualHost doit
# permettre AllowOverride All sur ce dossier).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse publique : andiamusic.app, les « www » et les anciens domaines
  # (abilia-music.app, abilia-music.fr, s'ils pointent encore ici) redirigent vers andiamusic.fr
  # (même chemin), pour que les moteurs de recherche ne voient pas le site en double. Chaque nom
  # doit avoir son certificat sur le VPS (ServerAlias du même VirtualHost).
  RewriteCond %{HTTP_HOST} ^www\.andiamusic\.fr$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^(www\.)?andiamusic\.app$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^(www\.)?abilia-music\.(app|fr)$ [NC]
  RewriteRule ^(.*)$ https://andiamusic.fr/$1 [L,R=301]

  # HTTPS partout (Apache seul sur le VPS, sans proxy devant : le port suffit ; /en → /en/ est
  # déjà fait par Apache, DirectorySlash).
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  # HSTS sans includeSubDomains ni preload jusqu'au changement de domaine (docs/CONVENTIONS.md).
  Header always set Strict-Transport-Security "max-age=31536000"
  # Content-Security-Policy en observation (Report-Only) : rien n'est bloqué, les violations
  # s'affichent dans la console. Le repère de script-src est remplacé par les empreintes des scripts
  # en ligne à chaque `npm run build` (scripts/csp.mjs). Passage en mode strict : docs/CONVENTIONS.md.
  Header always set Content-Security-Policy-Report-Only "default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' {{CSP_SCRIPT_HASHES}}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

  # Fichiers du build dont le nom porte une empreinte : gardés un an sans revalidation.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images de partage et icônes : noms fixes, gardées une semaine (le bloc <If> ci-dessus passe
  # après les <FilesMatch> dans l'ordre d'Apache : les images de /_astro/ restent à un an).
  <FilesMatch "\.(jpg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Pages HTML : toujours revalidées, pour qu'une mise en ligne se voie tout de suite.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  # Le plan du site (application/xml) et robots.txt (text/plain) aussi : les robots les lisent souvent.
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/xml text/plain application/manifest+json
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
