# Configuration Apache de l'hébergement mutualisé OVH (copiée à la racine du site par le build).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse publique : abilia-music.fr et les « www » redirigent vers abilia-music.app
  # (même chemin), pour que les moteurs de recherche ne voient pas le site en double. Les deux
  # domaines sont rattachés au même hébergement en multisite, dossier www.
  RewriteCond %{HTTP_HOST} ^(www\.)?abilia-music\.fr$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.abilia-music\.app$ [NC]
  RewriteRule ^(.*)$ https://abilia-music.app/$1 [L,R=301]

  # HTTPS partout (règle recommandée par OVH ; /en → /en/ est déjà fait par Apache, DirectorySlash).
  RewriteCond %{SERVER_PORT} 80
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Fichiers du build dont le nom porte une empreinte : gardés un an sans revalidation.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images de partage et icônes : noms fixes, gardées une semaine (le bloc <If> ci-dessus passe
  # après les <FilesMatch> dans l'ordre d'Apache : les images de /_astro/ restent à un an).
  <FilesMatch "\.(jpg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Pages HTML : toujours revalidées, pour qu'une mise en ligne se voie tout de suite.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
